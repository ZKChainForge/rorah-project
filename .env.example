# RORAH Configuration Template
# Copy to .env and fill in values

# Network
RORAH_NETWORK=testnet
RORAH_P2P_PORT=9000
RORAH_RPC_PORT=8545

# Ethereum L1
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
ETH_CHAIN_ID=11155111

# EigenLayer
EIGENLAYER_CONTRACT_ADDRESS=0x...
RORAH_AVS_ADDRESS=0x...

# Operator
OPERATOR_PRIVATE_KEY=0x...
OPERATOR_STAKE_AMOUNT=1000

# Performance
MAX_PROOFS_PER_BATCH=50
FOLDING_TIMEOUT_SECONDS=10

# Security
ENABLE_SLASHING=true
MIN_STAKE_ETH=32

# Logging
RUST_LOG=info
RUST_BACKTRACE=1